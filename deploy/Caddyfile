# Caddy gets and renews the Let's Encrypt certificates automatically.
# The DNS records must point to this server, ports 80 and 443 open.
{$API_DOMAIN} {
	encode zstd gzip
	# The API parses a whole upload before it checks who sent it, so refuse big bodies here:
	# 3 files of 5 MB (BE-33) plus the form fields. Everything else in the API is small.
	request_body {
		max_size 20MB
	}
	reverse_proxy api:8000
}

# Web app (ticketoff-web): static build copied to ./web on the host.
{$WEB_DOMAIN} {
	root * /srv/web
	encode zstd gzip

	# Hashed build files never change; index.html must be re-read on every deploy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@notassets not path /assets/*
	header @notassets Cache-Control "no-cache"

	# Build files: served as is. A missing chunk (e.g. removed by a later deploy) is a
	# real 404, not index.html, or the browser would cache HTML as JS for a year.
	handle /assets/* {
		file_server
	}

	# SPA: other unknown paths (/login, /events/123) get index.html, React Router handles them.
	handle {
		try_files {path} /index.html
		file_server
	}

	# Without this the 404 inherits the one-year immutable header from @assets.
	handle_errors 404 {
		header Cache-Control "no-store"
		respond "Not found" 404
	}
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
