DATABASE_URL=postgresql+psycopg://ticketoff:ticketoff@localhost:5432/ticketoff
# Secrets: at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-of-32-plus-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Must differ from JWT_SECRET. Generate with: openssl rand -hex 32
TICKET_SIGNING_SECRET=change-me-to-another-random-secret-32-plus
ENVIRONMENT=local
# Simulated payments (no real money). Defaults shown.
# ACTIVATION_FEE_KZT=5000
# PROCESSING_FEE_PERCENT=3
# CHECKOUT_HOLD_MINUTES=15
# Comma-separated origins of the web app allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Public address of the web app. Campaign QR codes and every email link point at it.
# FRONTEND_URL=https://ticketoff.store

# --- Email (BE-18) ---
# console (default): nothing is sent; with ENVIRONMENT=local each email is written to the
#   log, body included (verification emails: body hidden, it holds a secret link).
# smtp: sends through the SMTP_* server below (SMTP_HOST is required, checked at startup).
# EMAIL_PROVIDER=console
# EMAIL_FROM=ticketoff <no-reply@ticketoff.store>
# SMTP_USER may stay empty for a server without login. SMTP_TIMEOUT is in seconds: a slow
# server fails only that email (logged), never the action. Emails are sent after the commit
# in the same request, so the request waits for them (up to SMTP_TIMEOUT each).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_TIMEOUT=10
