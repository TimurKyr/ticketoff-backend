# Copy to .env on the server and fill in. Never commit the real .env.
ENVIRONMENT=production
API_DOMAIN=api.ticketoff.store
WEB_DOMAIN=ticketoff.store
# Web app origins allowed to call the API.
CORS_ORIGINS=https://ticketoff.store,https://www.ticketoff.store

POSTGRES_USER=ticketoff
POSTGRES_DB=ticketoff
# Hex only, it goes into DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters each, and they must differ: openssl rand -hex 32
JWT_SECRET=
TICKET_SIGNING_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
