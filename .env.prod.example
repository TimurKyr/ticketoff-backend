# Copy to .env on the server and fill in. Never commit the real .env.
ENVIRONMENT=production
API_DOMAIN=api.ticketoff.store
WEB_DOMAIN=ticketoff.store
# Web app origins allowed to call the API.
CORS_ORIGINS=https://ticketoff.store,https://www.ticketoff.store

POSTGRES_USER=ticketoff
POSTGRES_DB=ticketoff
# Hex only, it goes into DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters each, and they must differ: openssl rand -hex 32
JWT_SECRET=
TICKET_SIGNING_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (BE-18) ---
# console: sends nothing; logs only the recipient's domain and the subject (no body, no
#   address). Keep it until a mail service is chosen (open question for the team).
# smtp: real sending. Set EMAIL_PROVIDER=smtp and fill SMTP_HOST (required), SMTP_USER and
#   SMTP_PASSWORD from the mail service; EMAIL_FROM must be an address on a domain that
#   service is allowed to send for (SPF/DKIM), or the emails land in spam.
EMAIL_PROVIDER=console
EMAIL_FROM=ticketoff <no-reply@ticketoff.store>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Seconds, per SMTP step. A slow or dead mail server fails only that email (logged), never
# the action. Emails are sent after the commit in the same request, so the request waits for
# them: cancelling an event with many buyers can be slow with SMTP (background sending is a
# follow-up).
SMTP_TIMEOUT=10
